OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
OPENAI_THINKING=enabled
OPENAI_REASONING_EFFORT=high
OPENAI_TIMEOUT=180
OPENAI_MAX_RETRIES=0
# 估算费用单价（美元 / 百万 token），只影响报告中的 estimated_cost_usd 展示
INPUT_TOKEN_PRICE_PER_MILLION=0.27
OUTPUT_TOKEN_PRICE_PER_MILLION=1.10
LOG_LEVEL=INFO
LOG_FORMAT=console
GITHUB_TOKEN=
GITHUB_MAX_FILE_BYTES=512000
GITHUB_TIMEOUT=30
GITHUB_MAX_RETRIES=3
# GitHub API 响应缓存（内存）：TTL 秒、最大条目数、最大字节数
GITHUB_CACHE_TTL_SECONDS=300
GITHUB_CACHE_MAX_ENTRIES=512
GITHUB_CACHE_MAX_BYTES=67108864
# 仓库文件树条目数上限，超过即拒绝分析
GITHUB_MAX_TREE_ENTRIES=200000
MAX_CANDIDATE_FILES=12
MAX_PLANNING_PATHS=80
MAX_FILE_CHARS=16000
MAX_TOTAL_CONTEXT_CHARS=80000
# 单次调查总时长上限（秒），防止模型工具循环耗尽 API 额度
INVESTIGATION_TIMEOUT=600
# 单个工具调用（如 search_code）的超时上限（秒）
TOOL_TIMEOUT=60
# 每轮工具规划的最大输出 token
MAX_EXPLORATION_TOKENS=2000
MAX_OUTPUT_TOKENS=8000
MAX_AGENT_ITERATIONS=15
# 并行执行的独立只读工具数量上限
MAX_PARALLEL_TOOL_CALLS=4
# 连续完全相同工具调用轮数上限（到达即停止探索）
MAX_DUPLICATE_TOOL_ROUNDS=2
MAX_INVESTIGATION_LEDGER_CHARS=12000
MAX_CHAT_TOKENS=2000
INDEPENDENT_REVIEW=true
# REVIEW_MODEL=
REVIEW_MAX_TOKENS=8000
MAX_REVIEW_CONTEXT_CHARS=32000
MAX_REPORT_RETRIES=3
LANGUAGE=zh
# API_KEY=
# WRITE_MODE=false
SESSION_DB_PATH=data/sessions.db
# 心跳超时（秒）：超过该时长没有心跳的 running 会话被视为孤儿并翻为 interrupted。
# 必须大于【单步最长等待】INVESTIGATION_TIMEOUT（默认 600）——否则正在跑的调查会被
# 误判为孤儿，前端显示"已中断"而服务其实仍在分析。与 app/config.py 默认值保持一致（300）。
SESSION_STALE_AFTER_SECONDS=300
SESSION_RETENTION_DAYS=30
MAX_PR_FILES=20
MAX_PR_TOTAL_BYTES=1000000
MAX_SESSION_IMPORT_BYTES=5242880
# Circuit breaker: fast-fail LLM calls after N consecutive failures
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY=30
# Batch analysis: max concurrent investigations and queue capacity
BATCH_MAX_CONCURRENT=2
BATCH_MAX_QUEUE_SIZE=100
# 批量任务历史保留数（超出后最早完成的批次被清除）
BATCH_MAX_HISTORY=100
# 按 API key 的滑动窗口限流：窗口内最大请求数与窗口秒数
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# 同时在跑的调查数上限（/stream 与新会话 /chat）。限流只按请求数计，而一次 /stream
# 可能跑满 INVESTIGATION_TIMEOUT，所以还需要并发闸门兜住 token 成本与 SQLite 写入压力；
# 超出后新请求会立刻收到 429/error 事件（而不是排队等十几分钟）。
MAX_CONCURRENT_INVESTIGATIONS=3
# 单次调查的估算成本上限（美元；按 INPUT/OUTPUT_TOKEN_PRICE_PER_MILLION 折算）。
# 0 = 不限制。超限时在迭代间隙中止调查并返回一条可读的 error 事件，避免模型陷入
# 循环时只有「轮次/时长」两个上界而金额无上界。
MAX_SESSION_ESTIMATED_COST_USD=0
